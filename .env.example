# Discord application (reuse the old harumin app). Bot token from the Bot tab.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Where /eval registers, and who may run it.
DEV_GUILD_ID=
OWNER_ID=

# osu! OAuth app (client credentials).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Calls per minute to osu! (shared by every command and the /track poller).
OSU_RATE_PER_MINUTE=120

# The cluster with harumin's own database ("harumin": settings, tracks, member records).
MONGODB_URI=mongodb://localhost:27017
# The cluster with the hub's "identity" database, as a read-only user.
IDENTITY_MONGODB_URI=mongodb://localhost:27017

HUB_URL=https://haruhime.moe
SITE_URL=https://harumin.haruhime.moe

# Service routes the dashboard calls. Same token in the site's env.
HARUMIN_SERVICE_TOKEN=
SERVICE_PORT=8787

# .osu cache for pp.
CACHE_DIR=.cache/osu

# Optional: post the guild count to top.gg every 30 minutes.
TOPGG_TOKEN=

# Optional: pools.haruhime.moe's HARUMIN_SERVICE_SECRET, for /practice (at least 32 characters).
POOLS_SERVICE_SECRET=
